---
import Layout from '../layouts/Layout.astro';
import { site } from '../config';

const githubDisplay = site.github.replace('https://', '');
const linkedinDisplay = site.linkedin.replace('https://', '');
---

<Layout
  title={`Contact — ${site.name}`}
  description={`Get in touch with ${site.name}.`}
>
  <div class="page">

    <section class="page-header">
      <h1>Contact</h1>
      <p>
        I'm generally open to conversations about backend engineering, product development, 
        AI-assisted learning systems, and interesting problems worth solving.
      </p>
    </section>

    <ul class="contact-list">
      <li>
        <span class="label">Email</span>
        <a href={`mailto:${site.email}`}>
          {site.email}
        </a>
      </li>
      <li>
        <span class="label">LinkedIn</span>
        <a href={site.linkedin} target="_blank" rel="noopener">
          {linkedinDisplay}
        </a>
      </li>
      <li>
        <span class="label">GitHub</span>
        <a href={site.github} target="_blank" rel="noopener">
          {githubDisplay}
        </a>
      </li>
    </ul>

  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: 40px;
  }

  .page-header h1 { margin-bottom: 12px; }

  .contact-list {
    list-style: none;
    padding: 0;
  }

  .contact-list li {
    display: grid;
    grid-template-columns: 90px 1fr;
    align-items: baseline;
    padding: 18px 0;
    border-top: 1px solid var(--border);
    margin: 0;
  }

  .contact-list li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-3);
  }

  .contact-list a {
    font-size: 15px;
    color: var(--accent);
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .contact-list a:hover {
    opacity: 0.7;
    text-decoration: underline;
  }
</style>
