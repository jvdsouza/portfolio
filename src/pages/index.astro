---
import Layout from '../layouts/Layout.astro';
import { site } from '../config';

const base = import.meta.env.BASE_URL;
const githubDisplay = site.github.replace('https://', '');
const linkedinDisplay = site.linkedin.replace('https://', '');
---

<Layout
  title={site.name}
  description={site.description}
>
  <div class="page">

    <section class="hero">
      <h1>{site.name}</h1>
      <p class="subtitle">{site.role}</p>
    </section>

    <hr />

    <section>
      <p>
        I build software with an emphasis on clarity, maintainability, and the humans on both
        sides of the system. My work spans product engineering, developer tooling, and learning
        technology — with a consistent interest in how systems are designed and how they hold up
        under real use.
      </p>
      <p>
        This site is a place to make my work and thinking legible. It's a work in progress.
      </p>
    </section>

    <hr />

    <section>
      <h2>Engineering focus</h2>
      <ul>
        <li>Learning systems and structured commentary for education</li>
        <li>Developer tooling and AI workflow integration</li>
        <li>System design — interfaces, APIs, data models, constraints</li>
      </ul>
    </section>

    <hr />

    <section>
      <h2>Find me</h2>
      <ul class="link-list">
        <li>
          <a href={site.github} target="_blank" rel="noopener">GitHub</a>
          <span class="link-note">{githubDisplay}</span>
        </li>
        <li>
          <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <span class="link-note">{linkedinDisplay}</span>
        </li>
        <li>
          <a href={`${base}contact`}>Get in touch</a>
          <span class="link-note">email and more</span>
        </li>
      </ul>
    </section>

  </div>
</Layout>

<style>
  .subtitle {
    font-size: 1.125rem;
    color: var(--text-3);
    margin-bottom: 0;
  }

  h2 { margin-bottom: 16px; }

  .link-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .link-list li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
  }

  .link-note {
    font-size: 14px;
    color: var(--text-3);
  }
</style>
