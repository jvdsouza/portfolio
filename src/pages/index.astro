---
import Layout from '../layouts/Layout.astro';
import { site } from '../config';

const base = import.meta.env.BASE_URL;
const githubDisplay = site.github.replace('https://', '');
const linkedinDisplay = site.linkedin.replace('https://', '');
---

<Layout
  title={site.name}
  description={site.description}
>
  <div class="page">

    <section class="hero">
      <h1>{site.name}</h1>
      <p class="subtitle">{site.role}</p>
    </section>

    <hr />

    <section>
      <p>
        I'm a Full Stack Software Engineer with over five years of experience building and maintaining production software across backend APIs, customer-facing applications, developer tooling and cloud-based systems.
      </p>
      <p>
        I enjoy working through complex engineering problems: understanding how existing systems behave, identifying the constraints that matter, and developing practical solutions that improve reliability, maintainability and the experiences of the people using them.
      </p>
      <p>
        My experience spans both modern and legacy systems, from product engineering at Redbubble to cloud-based services and infrastructure at ANZx. I'm also exploring practical applications of AI in software development and educational products.
      </p>
    </section>

    <hr />

    <section>
      <h2>Engineering focus</h2>
      <ul>
        <li>Backend and full stack product engineering</li>
        <li>Understanding and improving complex existing systems</li>
        <li>Software architecture, APIs and distributed systems</li>
        <li>Developer tooling, operational automation and applied AI</li>
      </ul>
    </section>

    <hr />

    <section>
      <h2>Find me</h2>
      <ul class="link-list">
        <li>
          <a href={site.github} target="_blank" rel="noopener">GitHub</a>
          <span class="link-note">{githubDisplay}</span>
        </li>
        <li>
          <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <span class="link-note">{linkedinDisplay}</span>
        </li>
        <li>
          <a href={`${base}contact`}>Get in touch</a>
          <span class="link-note">email and more</span>
        </li>
      </ul>
    </section>

  </div>
</Layout>

<style>
  .subtitle {
    font-size: 1.125rem;
    color: var(--text-3);
    margin-bottom: 0;
  }

  h2 { margin-bottom: 16px; }

  .link-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .link-list li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
  }

  .link-note {
    font-size: 14px;
    color: var(--text-3);
  }
</style>
