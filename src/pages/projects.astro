---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { site } from '../config';

const base = import.meta.env.BASE_URL;

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

const slug = (id: string) => id.replace('/index.md', '');
const hasPreview = (body: string | undefined) => !!body?.trim();
---

<Layout
  title={`Projects — ${site.name}`}
  description="Selected projects in learning systems, engineering, and AI workflows."
>
  <div class="page">

    <section class="page-header">
      <h1>Projects</h1>
      <p>Selected work and experiments. Not exhaustive — focused on what's worth explaining.</p>
    </section>

    <div class="project-list">
      {projects.map((project) => (
        <article class="project">
          <div class="project-header">
            <h2>{project.data.title}</h2>
            <div class="meta">
              {project.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              <span class="status">{project.data.status}</span>
            </div>
          </div>
          {project.data.summary.map((paragraph) => <p>{paragraph}</p>)}
          <div class="links">
            {hasPreview(project.body) && (
              <a href={`${base}projects/${slug(project.id)}`} class="project-link">
                Check out a preview here →
              </a>
            )}
            {project.data.link && (
              <a href={project.data.link.url} target="_blank" rel="noopener" class="project-link">
                {project.data.link.title} →
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: 48px;
  }

  .page-header h1 { margin-bottom: 8px; }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .project {
    padding: 40px 0;
    border-top: 1px solid var(--border);
  }

  .project:last-child {
    border-bottom: 1px solid var(--border);
  }

  .project-header {
    margin-bottom: 12px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .tag {
    font-size: 12px;
    color: var(--text-2);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 2px 8px;
    line-height: 1.5;
  }

  .status {
    font-size: 12px;
    color: var(--text-3);
    margin-left: 2px;
  }

  .links {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }

  .project-link {
    display: inline-block;
    margin-top: 14px;
    font-size: 14px;
    font-weight: 500;
  }
</style>
