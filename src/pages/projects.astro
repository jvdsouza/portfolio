---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: 'Commentary Learning Framework',
    tags: ['Education', 'Product'],
    status: 'In development',
    description:
      'A framework for structured commentary in learning environments — enabling richer feedback, annotation, and dialogue around educational content. Replace this with a description of the problem, your approach, and what makes it interesting.',
    link: null as string | null,
  },
  {
    title: 'Engineering Project',
    tags: ['Engineering'],
    status: 'Coming soon',
    description:
      'Placeholder for an engineering-focused project. Describe the problem you were solving, your approach, and what you built. What made it technically interesting or hard?',
    link: null as string | null,
  },
  {
    title: 'AI Workflow Experimentation',
    tags: ['AI', 'Tooling'],
    status: 'Ongoing',
    description:
      'Exploration of how AI tools integrate into real engineering workflows — what works, what breaks, and where the interesting design problems are. Notes and experiments from ongoing use.',
    link: null as string | null,
  },
];
---

<Layout
  title="Projects — NAME HERE"
  description="Selected projects in learning systems, engineering, and AI workflows."
>
  <div class="page">

    <section class="page-header">
      <h1>Projects</h1>
      <p>Selected work and experiments. Not exhaustive — focused on what's worth explaining.</p>
    </section>

    <div class="project-list">
      {projects.map(({ title, tags, status, description, link }) => (
        <article class="project">
          <div class="project-header">
            <h2>{title}</h2>
            <div class="meta">
              {tags.map(tag => <span class="tag">{tag}</span>)}
              <span class="status">{status}</span>
            </div>
          </div>
          <p>{description}</p>
          {link && (
            <a href={link} target="_blank" rel="noopener" class="project-link">
              View project →
            </a>
          )}
        </article>
      ))}
    </div>

  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: 48px;
  }

  .page-header h1 { margin-bottom: 8px; }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .project {
    padding: 40px 0;
    border-top: 1px solid var(--border);
  }

  .project:last-child {
    border-bottom: 1px solid var(--border);
  }

  .project-header {
    margin-bottom: 12px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .tag {
    font-size: 12px;
    color: var(--text-2);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 2px 8px;
    line-height: 1.5;
  }

  .status {
    font-size: 12px;
    color: var(--text-3);
    margin-left: 2px;
  }

  .project-link {
    display: inline-block;
    margin-top: 14px;
    font-size: 14px;
    font-weight: 500;
  }
</style>
