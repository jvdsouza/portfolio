---
import Layout from '../layouts/Layout.astro';
import { site } from '../config';

const base = import.meta.env.BASE_URL;
---

<Layout
  title={`Resume — ${site.name}`}
  description={`${site.name} — software engineer resume.`}
>
  <div class="page">

    <section class="page-header">
      <div class="header-row">
        <h1>Resume</h1>
        <a href={`${base}resume.pdf`} class="download-btn" download>
          Download PDF
        </a>
      </div>
      <p class="hint">
        Add <code>resume.pdf</code> to the <code>public/</code> folder to enable the download.
      </p>
    </section>

    <hr />

    <section class="resume-section">
      <h2>Experience</h2>

      <div class="entry">
        <div class="entry-header">
          <span class="entry-title">Job Title · Company</span>
          <span class="entry-date">Month Year – Present</span>
        </div>
        <p>
          Describe what you built, what problem it solved, and what impact it had.
          Concrete outcomes over responsibilities.
        </p>
      </div>

      <div class="entry">
        <div class="entry-header">
          <span class="entry-title">Job Title · Company</span>
          <span class="entry-date">Month Year – Month Year</span>
        </div>
        <p>Another role. Replace this with actual content.</p>
      </div>
    </section>

    <hr />

    <section class="resume-section">
      <h2>Education</h2>

      <div class="entry">
        <div class="entry-header">
          <span class="entry-title">Degree · Institution</span>
          <span class="entry-date">Year</span>
        </div>
        <p>Relevant coursework, focus areas, or context. Optional.</p>
      </div>
    </section>

    <hr />

    <section class="resume-section">
      <h2>Skills</h2>

      <div class="skill-groups">
        <div class="skill-group">
          <h3>Languages</h3>
          <p>e.g. TypeScript, Python, Go, SQL</p>
        </div>
        <div class="skill-group">
          <h3>Frameworks & Tools</h3>
          <p>e.g. React, Node.js, Docker, PostgreSQL</p>
        </div>
        <div class="skill-group">
          <h3>Practices</h3>
          <p>e.g. system design, API design, CI/CD, technical writing</p>
        </div>
      </div>
    </section>

  </div>
</Layout>

<style>
  .page-header { margin-bottom: 0; }

  .header-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .header-row h1 { margin-bottom: 0; }

  .download-btn {
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px 14px;
    text-decoration: none;
    transition: border-color 0.15s;
    white-space: nowrap;
  }

  .download-btn:hover {
    border-color: var(--accent);
    text-decoration: none;
  }

  .hint {
    font-size: 13px;
    color: var(--text-3);
  }

  /* ── Section ── */
  .resume-section h2 {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 28px;
  }

  /* ── Entry (role / education item) ── */
  .entry { margin-bottom: 28px; }
  .entry:last-child { margin-bottom: 0; }

  .entry-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }

  .entry-title {
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
  }

  .entry-date {
    font-size: 13px;
    color: var(--text-3);
    white-space: nowrap;
  }

  /* ── Skills ── */
  .skill-groups {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .skill-group h3 { margin-bottom: 4px; }
</style>
